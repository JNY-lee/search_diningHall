map {
  width: 100%;
  height: 100vh;
}
.controls {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
}
.banner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 200rpx;
}
.gps {
  position: absolute;
  bottom: 200rpx;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
}